# General
TZ=Europe/Berlin
TIMEZONE_NAME=Europe/Berlin
WORKSPACE_DIR=/home/user/otalon-github

# Postgres DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<SET_POSTGRES_PASSWORD>
POSTGRES_PORT=5432
POSTGRES_DATABASE=otalon
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DATABASE}

# InfluxDB v3
INFLUX_URL=http://influxdb3:8181
# Must start with apiv3_. The same value is turned into the local, git-ignored
# shared/influx-admin-token.json bootstrap file described in INSTALL.md.
INFLUX_TOKEN=<SET_INFLUX_TOKEN>
INFLUXDB_HOST=influxdb3
INFLUXDB_PORT=8181
INFLUXDB_ORG=""
INFLUXDB_DATABASE=netcap

# Adapter
CAPTURE_TYPE=LIVE
CAPTURE_SOURCE=enp5s0
# Preferred default ACTIVE-SCAN interface (counterpart to CAPTURE_SOURCE=mirror).
# Empty = UI picks first active_scan.
SCAN_SOURCE=enp4s0
PCAP_BUFFER_DIR=/app/pcap/buffer
PCAP_ARCHIVE_DIR=/app/pcap/archive

# OTALON-CLAS general
#
# All training-window timestamps in this file are interpreted as UTC.
# The format is "YYYY-MM-DD HH:MM:SS" without a timezone suffix; the
# pipeline parses them as naive datetimes and stamps them with UTC
# before issuing InfluxDB queries. Convert local time accordingly
# (e.g. CEST = UTC+2 -> subtract 2 hours when entering values).
FREQUENCY_PERSISTENCE_ENABLED=true
MODULE_NETCAP_ENABLED=true
PREDICTION_CLASSIFICATION_ENABLED=true
TRAINING_CLASSIFICATION_MITRE_TECHNIQUE_FILE=/app/models/mitre_techniques_log.json

MODEL_DIR=/app/models

# OTALON-CLAS - Blacklists
# Set only reviewed, deployment-specific exclusions; no internal lab defaults.
SERIES_BLACKLIST=[]

# PCAP Flagging (optional)
PCAP_FLAGGING_ENABLED=true
PCAP_RECORDER_URL=http://host.docker.internal:9090

# AI Chat (otalon-ai service, MCP server for tool access)
MCP_SERVER_URL=http://otalon-mcp:9000
MCP_HOST=otalon-mcp
MCP_PORT=9000

# OTALON API
API_PORT=8090
ADMIN_API_KEY=<SET_ADMIN_API_KEY>

# Legacy plain-HTTP hints: this standalone Compose file does NOT consume
# either variable and they DO NOT restrict listening addresses. UI/API stay
# bridge-internal. Capture and scan use host networking; PostgreSQL and InfluxDB
# publish host ports. Restrict access with reviewed host firewall rules or a
# deployment-specific Compose override, and use HTTPS on 8443 for the browser.
HTTP_PLAIN_PORTS_ENABLED=true
HTTP_PLAIN_PORTS_BIND_ADDRESS=0.0.0.0
COMPOSE_PROFILES=all

# Session cookie Secure flag. MUST stay true (default) for HTTPS compose.
# API sets it per request: HTTPS/TLS-proxy requests get Secure; direct HTTP
# requests get a browser-compatible non-Secure cookie. This global setting
# remains a production safety default and is not a substitute for TLS.
SESSION_COOKIE_SECURE=true

# OTALON-MCP -> OTALON-API operator proxy.
# This consumer key must equal the :key component of an API allow-list entry.
OTALON_API_URL=http://otalon-api:8090
OTALON_API_KEY=<SET_OTALON_API_KEY>
OTALON_API_ALLOWED_KEYS=ui:operator:${ADMIN_API_KEY},mcp:operator:<SET_OTALON_API_KEY>,scan-ui:viewer:<SET_UI_SCAN_KEY>

# OTALON-SCAN auth allow-list (introduced by harden-OTALON-SCAN-security;
# fail-loud enforcement added in F-02 / refactor-otalon-scan-code-quality-v1).
# Format: comma-separated entries of `name:role:key`. Roles: viewer | operator.
# These are placeholders; generate real keys before any non-dev deployment.
# Generate keys via:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OTALON_SCAN_ALLOWED_KEYS=ui-prod:viewer:<SET_SCAN_VIEWER_KEY>,mcp-prod:operator:<SET_OTALON_SCAN_API_KEY>

# Outbound operator-level key used by otalon-api to call otalon-scan:8091
# (Wave C / scan--api-proxy). Must match an operator entry in
# OTALON_SCAN_ALLOWED_KEYS above. Fail-loud at otalon-api startup if empty.
OTALON_SCAN_API_KEY=<SET_OTALON_SCAN_API_KEY>

# Logging
OTALON_UI_LOG_FILE=/app/logs/ui.log
NETCAP_LOG_FILE=/app/logs/netcap_adapter.log
OTALON_CLAS_LOG_FILE=/app/logs/otalon-clas.log
OTALON_MCP_LOG_FILE=/app/logs/otalon-mcp.log
MCP_LOG_FILE=/app/logs/otalon-mcp.log
OTALON_SCAN_LOG_FILE=/app/logs/otalon-scan.log
PCAP_LOG_FILE=/app/logs/pcap_recorder.log
API_LOG_FILE=/app/logs/api.log
UI_NEXT_LOG_FILE=/app/logs/ui-next.log

# Optional legacy provider fields. otalon-ai's runtime path is LiteLLM.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_REASONING_EFFORT=
MCP_URL=http://otalon-mcp:9000
OPENAI_COMPAT_ENDPOINT=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_DEFAULT_MODEL=

# Internal-only by default. Leave blank unless MCP host publishing is
# explicitly approved for this deployment.
OTALON_MCP_EXTERNAL_PORT=
OTALON_MCP_ALLOWED_KEYS=otalon-ai:operator:<SET_OTALON_MCP_API_KEY>
# Server-to-server consumer credential presented by otalon-ai (chat + jobs)
# to otalon-mcp as an X-API-Key header. It MUST equal the exact
# :key component of one OTALON_MCP_ALLOWED_KEYS entry above. The
# allow-list is producer-owned and fail-closed; this is the matching
# consumer half. Keep both in the operator-owned .env.compose; neither
# reaches the browser/UI bundle. Generate via:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OTALON_MCP_API_KEY=<SET_OTALON_MCP_API_KEY>
OTALON_MCP_CONFIRM_NONCE_TTL=300

# OTALON-AI (consolidated chat orchestration + subagent jobs)
# The UI key must be the exact key component of one AI allow-list entry.
# Keep both values in the operator-owned .env.compose; neither reaches the browser.
OTALON_AI_ALLOWED_KEYS=ui:viewer:<SET_OTALON_AI_UI_KEY>,internal:operator:<SET_OTALON_AI_INTERNAL_KEY>
OTALON_AI_UI_KEY=<SET_OTALON_AI_UI_KEY>
# AI-045: interner API->otalon-ai-Schlüssel (Rolle operator). Eigener Key, nicht UI-Key.
OTALON_AI_INTERNAL_KEY=<SET_OTALON_AI_INTERNAL_KEY>
OTALON_BUILD_REF=<git-sha-or-release-ref>
RETRAIN_COOLDOWN_MINUTES=30
# Keep false unless the configured LLM is an approved on-premises endpoint.
OTALON_ON_PREM_LLM_CONTEXT=false

# LiteLLM proxy runs on the host at :4000; reach it via host.docker.internal
# (same pattern as PCAP_RECORDER_URL above).
LITELLM_BASE_URL=http://host.docker.internal:4000/v1
LITELLM_API_KEY=<SET_LITELLM_API_KEY>

# Chat surface
CHAT_LLM_MODEL=<SET_CHAT_LLM_MODEL>
CHAT_LLM_REASONING_EFFORT=
CHAT_DB_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DATABASE}
CHAT_MCP_URL=http://otalon-mcp:9000/mcp
CHAT_HISTORY_WINDOW=20
CHAT_RETENTION_DAYS=30
CHAT_MAX_TOOL_ROUNDS=12
CHAT_MODEL_CONTEXT_WINDOW=128000

# Jobs surface
JOBS_LLM_MODEL=<SET_JOBS_LLM_MODEL>
JOBS_LLM_REASONING_EFFORT=
JOBS_DEFAULT_PROMPT=expert
JOBS_TIMEOUT_SECONDS=600
JOBS_N_WORKERS=4
JOBS_LOG_LEVEL=INFO

# AI service URL and port
AI_PORT=9100
AI_URL=http://otalon-ai:9100

# CVE-Lookup auto-loop worker (optional). Requires NVD_API_KEY for higher rate.
CVE_LOOKUP_ENABLED=false
CVE_LOOKUP_INTERVAL_S=86400
NVD_API_KEY=

# Future parallel deployment hint -- see design.md Decision 12. Not enabled
# in this change.
#  nanobot:
#    image: nanobot/nanobot:latest
#    environment:
#      LITELLM_BASE_URL: http://litellm-proxy:4000/v1
#      MCP_URL: http://otalon-mcp:9000/mcp

# ============================================================================
# add-passive-asset-seeder -- passive InfluxDB -> PostgreSQL inventory seeder.
# Runs as the docker-compose service `otalon-scan-passive-seeder` (profiles
# `adapters` and `all`). Default-OFF in v1; flip ENABLED=true after a one-week
# dogfood window per design.md decision D-FEATURE-FLAG.
# ============================================================================
PASSIVE_SEEDER_ENABLED=false
PASSIVE_SEEDER_POLL_INTERVAL_S=60
PASSIVE_SEEDER_LOOKBACK_WINDOW_S=300
PASSIVE_SEEDER_INFLUX_URL=http://influxdb3:8181
# PASSIVE_SEEDER_INFLUX_TOKEN -- defaults to the workspace INFLUX_TOKEN at
# container-build time; override here for least-privilege deployments.
PASSIVE_SEEDER_INFLUX_TOKEN=${INFLUX_TOKEN}
PASSIVE_SEEDER_INFLUX_BUCKET=netcap
PASSIVE_SEEDER_DROP_LAA=false

# ============================================================================
# pcap-import-replay (UI-078) -- offline PCAP import.
#
# Read by TWO services:
#   * otalon-api             -- upload endpoint, job ownership, dispatch
#                               (PCAP_IMPORT_DIR .. PCAP_IMPORT_ARCHIVE_KEEP)
#   * netcap-pcap-import     -- the import worker itself
#                               (PCAP_IMPORT_API_BASE_URL, PCAP_IMPORT_LOG_FILE,
#                                PCAP_IMPORT_WORKER_TOKEN)
#
# PCAP_IMPORT_DIR must match the container path of the `pcap-import-data`
# volume in BOTH services (docker-compose.yml): the api hands the worker an
# absolute path which the worker opens verbatim.
#
# Both services are on the default bridge, so they address each other by
# compose service name -- the worker is NOT reachable from the host and does
# not need to be.
# ============================================================================
PCAP_IMPORT_DIR=/import
PCAP_IMPORT_MAX_UPLOAD_BYTES=536870912
PCAP_IMPORT_WORKER_HOST=otalon-capture-pcap-import
PCAP_IMPORT_WORKER_PORT=9092
PCAP_IMPORT_WORKER_TIMEOUT_S=10.0
# ONE secret, TWO containers, deliberately the same variable name on both
# sides (Wave A report S6 / Wave B report S3.1): the api signs its
# PATCH /internal/jobs/{display_id} callbacks with it and the worker presents
# it. Generate once per deployment, e.g. `openssl rand -hex 32`.
# Left EMPTY here on purpose: the report channel then fails closed with 503
# instead of accepting unauthenticated job updates. That is the intended safe
# default, not a bug -- but the import only completes once it is set.
PCAP_IMPORT_WORKER_TOKEN=
PCAP_IMPORT_DISPATCH_INTERVAL_S=5.0
PCAP_IMPORT_ORPHAN_GRACE_S=120.0
PCAP_IMPORT_ARCHIVE_KEEP=20
# --- worker side (netcap-pcap-import) ---
# Report channel target. Service-name DNS: the api is on the bridge too.
PCAP_IMPORT_API_BASE_URL=http://otalon-api:8090
PCAP_IMPORT_LOG_FILE=/app/logs/pcap_import.log
