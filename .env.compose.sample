# ==========================================================================
# EDIT THIS SECTION: setup.py fills missing/template local secrets and derives
# WORKSPACE_DIR/OTALON_BUILD_REF. Review operator-owned inputs before Compose.
# External credentials/model aliases and approved interfaces remain manual.
# Allow-lists below reuse the matching consumer credentials automatically.
# Native Linux physical capture only; Docker Desktop/WSL limits: see INSTALL.md.
#
# Host and platform
TZ=Europe/Berlin
TIMEZONE_NAME=Europe/Berlin
WORKSPACE_DIR=/home/user/otalon
CAPTURE_TYPE=LIVE
CAPTURE_SOURCE=enp5s0
# Preferred default ACTIVE-SCAN interface (counterpart to CAPTURE_SOURCE=mirror).
# Empty = UI picks first active_scan.
SCAN_SOURCE=enp4s0

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<SET_POSTGRES_PASSWORD>
POSTGRES_PORT=5432
POSTGRES_DATABASE=otalon

# InfluxDB administrator token must start with apiv3_. INSTALL.md creates its
# local shared/influx-admin-token.json bootstrap file from this value.
INFLUX_TOKEN=<SET_INFLUX_TOKEN>

# API and service credentials. ADMIN_API_KEY is also the UI operator key and
# existing PCAP recorder/import-worker operator credential.
ADMIN_API_KEY=<SET_ADMIN_API_KEY>
OTALON_API_KEY=<SET_OTALON_API_KEY>
OTALON_SCAN_API_KEY=<SET_OTALON_SCAN_API_KEY>
OTALON_API_SCAN_UI_KEY=<SET_UI_SCAN_KEY>
OTALON_SCAN_VIEWER_KEY=<SET_SCAN_VIEWER_KEY>
OTALON_MCP_API_KEY=<SET_OTALON_MCP_API_KEY>
OTALON_AI_UI_KEY=<SET_OTALON_AI_UI_KEY>
OTALON_AI_INTERNAL_KEY=<SET_OTALON_AI_INTERNAL_KEY>
PCAP_IMPORT_WORKER_TOKEN=<SET_PCAP_IMPORT_WORKER_TOKEN>

# External LiteLLM-compatible service and aliases; providers/models are not
# bundled. Set aliases that are actually served by this endpoint.
LITELLM_BASE_URL=http://host.docker.internal:4000/v1
LITELLM_API_KEY=<SET_LITELLM_API_KEY>
CHAT_LLM_MODEL=<SET_CHAT_LLM_MODEL>
JOBS_LLM_MODEL=<SET_JOBS_LLM_MODEL>

# Reviewed optional inputs
OTALON_BUILD_REF=<SET_OTALON_BUILD_REF>
OTALON_ON_PREM_LLM_CONTEXT=false
SERIES_BLACKLIST=[]
NVD_API_KEY=
FREQUENCY_PERSISTENCE_ENABLED=true
MODULE_NETCAP_ENABLED=true
PREDICTION_CLASSIFICATION_ENABLED=true
PCAP_FLAGGING_ENABLED=true
CVE_LOOKUP_ENABLED=false
PASSIVE_SEEDER_ENABLED=false

# Optional provider/context inputs; legacy direct-provider fields are unused by otalon-ai.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_REASONING_EFFORT=
OPENAI_COMPAT_ENDPOINT=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_DEFAULT_MODEL=
OTALON_MCP_EXTERNAL_PORT=
CHAT_LLM_REASONING_EFFORT=
CHAT_MODEL_CONTEXT_WINDOW=128000
JOBS_LLM_REASONING_EFFORT=

# END EDIT THIS SECTION
# Do not change values below for initial setup. These are derived internal
# endpoints, DSNs, paths, logs, allow-lists, and tuning defaults.

# PostgreSQL DSNs derive from the operator-owned values above.
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DATABASE}

# InfluxDB internal connection
INFLUX_URL=http://influxdb3:8181
INFLUXDB_HOST=influxdb3
INFLUXDB_PORT=8181
INFLUXDB_ORG=""
INFLUXDB_DATABASE=netcap

# Capture paths
PCAP_BUFFER_DIR=/app/pcap/buffer
PCAP_ARCHIVE_DIR=/app/pcap/archive

# OTALON-CLAS settings
# All training-window timestamps are interpreted as UTC. Format is
# "YYYY-MM-DD HH:MM:SS" without timezone suffix; convert local time to UTC.
TRAINING_CLASSIFICATION_MITRE_TECHNIQUE_FILE=/app/models/mitre_techniques_log.json
MODEL_DIR=/app/models

# Set only reviewed deployment-specific exclusions; no internal lab defaults.

# PCAP flagging
PCAP_RECORDER_URL=http://host.docker.internal:9090

# AI Chat and MCP internal services
MCP_SERVER_URL=http://otalon-mcp:9000
MCP_HOST=otalon-mcp
MCP_PORT=9000

# OTALON API
API_PORT=8090
# Legacy plain-HTTP hints are ignored by standalone Compose. UI/API stay
# bridge-internal. Capture and scan use host networking; DB ports are published
# on all interfaces. Use reviewed host firewall rules and HTTPS on 8443.
HTTP_PLAIN_PORTS_ENABLED=true
HTTP_PLAIN_PORTS_BIND_ADDRESS=0.0.0.0
COMPOSE_PROFILES=all

# Keep true for HTTPS Compose. This global default does not replace TLS.
SESSION_COOKIE_SECURE=true

# OTALON-MCP -> OTALON-API operator proxy
OTALON_API_URL=http://otalon-api:8090
OTALON_API_ALLOWED_KEYS=ui:operator:${ADMIN_API_KEY},mcp:operator:${OTALON_API_KEY},scan-ui:viewer:${OTALON_API_SCAN_UI_KEY}

# OTALON-SCAN auth allow-list
OTALON_SCAN_ALLOWED_KEYS=ui-prod:viewer:${OTALON_SCAN_VIEWER_KEY},mcp-prod:operator:${OTALON_SCAN_API_KEY}

# Logging
OTALON_UI_LOG_FILE=/app/logs/ui.log
NETCAP_LOG_FILE=/app/logs/netcap_adapter.log
OTALON_CLAS_LOG_FILE=/app/logs/otalon-clas.log
OTALON_MCP_LOG_FILE=/app/logs/otalon-mcp.log
MCP_LOG_FILE=/app/logs/otalon-mcp.log
OTALON_SCAN_LOG_FILE=/app/logs/otalon-scan.log
PCAP_LOG_FILE=/app/logs/pcap_recorder.log
API_LOG_FILE=/app/logs/api.log
UI_NEXT_LOG_FILE=/app/logs/ui-next.log

MCP_URL=http://otalon-mcp:9000

# MCP remains internal; publishing needs an approved Compose change.
OTALON_MCP_ALLOWED_KEYS=otalon-ai:operator:${OTALON_MCP_API_KEY}
OTALON_MCP_CONFIRM_NONCE_TTL=300

# OTALON-AI allow-list and tuning
OTALON_AI_ALLOWED_KEYS=ui:viewer:${OTALON_AI_UI_KEY},internal:operator:${OTALON_AI_INTERNAL_KEY}
RETRAIN_COOLDOWN_MINUTES=30

# Chat surface
CHAT_DB_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DATABASE}
CHAT_MCP_URL=http://otalon-mcp:9000/mcp
CHAT_HISTORY_WINDOW=20
CHAT_RETENTION_DAYS=30
CHAT_MAX_TOOL_ROUNDS=12

# Jobs surface
JOBS_DEFAULT_PROMPT=expert
JOBS_TIMEOUT_SECONDS=600
JOBS_N_WORKERS=4
JOBS_LOG_LEVEL=INFO

# AI service URL and port
AI_PORT=9100
AI_URL=http://otalon-ai:9100

# CVE lookup
CVE_LOOKUP_INTERVAL_S=86400

# Passive InfluxDB -> PostgreSQL inventory seeder.
PASSIVE_SEEDER_POLL_INTERVAL_S=60
PASSIVE_SEEDER_LOOKBACK_WINDOW_S=300
PASSIVE_SEEDER_INFLUX_URL=http://influxdb3:8181
# Preserve the shared INFLUX_TOKEN default; override only for a reviewed
# least-privilege deployment.
PASSIVE_SEEDER_INFLUX_TOKEN=${INFLUX_TOKEN}
PASSIVE_SEEDER_INFLUX_BUCKET=netcap
PASSIVE_SEEDER_DROP_LAA=false

# Offline PCAP import. PCAP_IMPORT_DIR must match the named volume mount path.
PCAP_IMPORT_DIR=/import
PCAP_IMPORT_MAX_UPLOAD_BYTES=536870912
PCAP_IMPORT_WORKER_HOST=otalon-capture-pcap-import
PCAP_IMPORT_WORKER_PORT=9092
PCAP_IMPORT_WORKER_TIMEOUT_S=10.0
PCAP_IMPORT_DISPATCH_INTERVAL_S=5.0
PCAP_IMPORT_ORPHAN_GRACE_S=120.0
PCAP_IMPORT_ARCHIVE_KEEP=20
# Worker report-channel target on the Compose bridge.
PCAP_IMPORT_API_BASE_URL=http://otalon-api:8090
PCAP_IMPORT_LOG_FILE=/app/logs/pcap_import.log
